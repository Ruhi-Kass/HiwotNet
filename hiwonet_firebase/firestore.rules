rules_version = '2';

// HIWONET-RESPONSE — Firestore security rules.
//
// Design principles (see the backend plan):
//   * Deny by default. Any path without a matching rule below is closed,
//     including for admins ("unknownCollection" scenarios in the tests).
//   * Clients READ; Cloud Functions WRITE. Every sensitive mutation
//     (registration, approval, role/status changes, dispatch, audit) goes
//     through a callable function using the Admin SDK, which bypasses
//     these rules. So almost every `write` here is `false` on purpose.
//   * Roles come from Auth custom claims (`role`), never from a field in a
//     Firestore document a client could edit.
//   * `suspended: true` in the token is defence in depth. Real lockout is
//     disabling the Auth user + revoking refresh tokens (in a function);
//     the claim closes the window while an old ID token is still valid.
//
// The single exception is a crew member updating the `status` of their own
// ambulance, which keeps the field app responsive without a function call.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function active() {
      return signedIn() && request.auth.token.get('suspended', false) != true;
    }

    function role() {
      return request.auth.token.get('role', null);
    }

    function hasRole(r) {
      return active() && role() == r;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isOps() {
      return hasRole('admin') || hasRole('dispatcher');
    }

    // ---- Accounts --------------------------------------------------------

    // A user can read their own profile; admins can read everyone.
    // Nobody writes from a client: roles and status change via functions.
    match /users/{uid} {
      allow read: if isAdmin() || (active() && request.auth.uid == uid);
      allow write: if false;
    }

    // Created by the `submitRegistration` callable, never by a client.
    match /registrationRequests/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---- Network ---------------------------------------------------------

    match /hospitals/{id} {
      allow read: if isOps();
      allow write: if false;
    }

    match /ambulances/{unitId} {
      allow read: if isOps()
        || (hasRole('crew') && resource.data.crewUid == request.auth.uid);

      // Crew may change only `status` on the unit they are assigned to,
      // and only to a known value.
      allow update: if hasRole('crew')
        && resource.data.crewUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in
             ['available', 'enRoute', 'onScene', 'transporting', 'offline'];

      allow create, delete: if false;
    }

    // ---- Operations ------------------------------------------------------

    match /incidents/{id} {
      allow read: if isOps();
      allow write: if false;

      match /events/{eventId} {
        allow read: if isOps();
        allow write: if false;
      }
    }

    match /alerts/{id} {
      allow read: if isOps();
      allow write: if false;
    }

    // ---- Governance ------------------------------------------------------

    // Append-only and server-written: no client can forge, edit or delete.
    match /auditLog/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /stats/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Test catalog and recorded runs (written by scripts/ with the Admin SDK).
    match /testCases/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /testRuns/{runId} {
      allow read: if isAdmin();
      allow write: if false;

      match /results/{resultId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }
  }
}
