{
  "rules": {
    ".read": false,
    ".write": false,

    "positions": {
      ".read": "auth != null && auth.token.suspended !== true && (auth.token.role === 'dispatcher' || auth.token.role === 'admin')",

      "$unitId": {
        ".write": "auth != null && auth.token.suspended !== true && auth.token.role === 'crew' && auth.token.unitId === $unitId",
        ".validate": "newData.hasChildren(['lat', 'lng', 'ts'])",

        "lat": {
          ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
        },
        "lng": {
          ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
        },
        "ts": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },

        "$other": {
          ".validate": false
        }
      }
    }
  }
}
